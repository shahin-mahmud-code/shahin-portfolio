---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('home', 'home');
if (!entry) {
  throw new Error('content/home.md is missing or was not loaded.');
}
const { title, description, name, location, role, tagline, links, skills, education } = entry.data;
const { Content } = await render(entry);

const year = new Date().getFullYear();
---

<Base title={title} description={description}>
  <header class="wrap hero">
    <p class="eyebrow">{location}</p>
    <h1>{name}</h1>
    <p class="role">{role}</p>
    <p class="tagline">{tagline}</p>
    <ul class="links" aria-label="Profiles">
      {
        links.map((link) => (
          <li>
            <a class="button" href={link.href} rel="me">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </header>

  <main id="main" class="wrap">
    <section class="section" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <Content />
    </section>

    <section class="section" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Skills</h2>
      <dl class="skills">
        {
          skills.map((group) => (
            <div class="skill-group">
              <dt>{group.label}</dt>
              <dd>
                <ul class="chips">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <ul class="edu">
        {
          education.map((entry) => (
            <li>
              <p class="edu-degree">{entry.degree}</p>
              <p class="edu-meta">
                {entry.school}, {entry.year}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="wrap site-footer">
    <p>© {year} {name}</p>
  </footer>
</Base>
